generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Provisioned out of band after target-database audit. Runtime only reads this
// singleton and fails closed when it is missing or does not match configuration.
model DeploymentNamespace {
  id                String @id @default("singleton")
  namespaceId       String @unique
  firebaseProjectId String
  huroofPolicyRevisions HuroofIdentityPolicyRevision[]
}

// ---------- Users & Auth ----------

model User {
  id             String   @id @default(cuid())
  name           String   @unique
  role           String   @default("USER") // USER | ADMIN
  remainingGames Int      @default(1) // free first game
  // Never spends a credit and never runs out — for whoever runs the app.
  unlimitedGames Boolean  @default(false)
  createdAt      DateTime @default(now())

  purchases          Purchase[]
  giftsSent          GiftCode[]         @relation("GiftSender")
  giftsRedeemed      GiftCode[]         @relation("GiftRedeemer")
  games              Game[]
  tournaments        Tournament[]
  favorites          FavoriteCategory[]
  firebaseIdentities FirebaseIdentity[]
}

// New-project Firebase identities are independent from historical shared-code
// accounts. The composite key is the external identity authority; userId is an
// optional private link added only by a later reviewed account-linking flow.
model FirebaseIdentity {
  id                String   @id @default(cuid())
  firebaseProjectId String
  firebaseUid       String
  userId            String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  scopes FirebaseAdminScope[]
  wallet Wallet?
  admissions Admission[]
  games Game[]
  entaModeEvidenceReviews EntaModeReleaseEvidence[]
  walletEntries WalletEntry[] @relation("WalletEntryActor")
  huroofRooms HuroofRoom[]
  huroofMembers HuroofMember[]
  huroofCommands HuroofCommandReceipt[]
  huroofContentRevisions HuroofContentRevision[]
  huroofContentAudits HuroofContentAudit[]
  huroofResults HuroofMatchResult[]
  huroofHistoryHeads HuroofOwnerHistoryHead[]

  @@unique([firebaseProjectId, firebaseUid])
  @@index([firebaseUid])
}

// Admin authority is reread from PostgreSQL on each request. Firebase name,
// email, and client-supplied roles never grant access.
model FirebaseAdminScope {
  id                String @id @default(cuid())
  firebaseProjectId String
  firebaseUid       String
  scope             String

  identity FirebaseIdentity @relation(fields: [firebaseProjectId, firebaseUid], references: [firebaseProjectId, firebaseUid], onDelete: Cascade)

  @@unique([firebaseProjectId, firebaseUid, scope])
  @@index([firebaseProjectId, firebaseUid])
}

// One person's starred categories — a shortcut through six hundred of them.
model FavoriteCategory {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
}

// Singleton row (id is always "singleton") holding the one shared access
// code everyone logs in with — editable from the admin panel instead of
// requiring a redeploy to change.
model AppSetting {
  id         String @id @default("singleton")
  accessCode String
}

// ---------- Commerce ----------

model Package {
  id         String     @id @default(cuid())
  name       String
  gamesCount Int
  price      Float
  currency   String     @default("BHD")
  active     Boolean    @default(true)
  sortOrder  Int        @default(0)
  purchases  Purchase[]
  giftCodes  GiftCode[]
}

model DiscountCode {
  id         String     @id @default(cuid())
  code       String     @unique
  percentOff Int // 0-100
  maxUses    Int        @default(1)
  usedCount  Int        @default(0)
  active     Boolean    @default(true)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  purchases  Purchase[]
}

model Purchase {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  packageId      String
  package        Package       @relation(fields: [packageId], references: [id])
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  amount         Float
  status         String        @default("PENDING") // PENDING | PAID | FAILED
  purpose        String        @default("SELF") // SELF | GIFT
  giftToPhone    String? // set when purpose = GIFT
  provider       String? // tap | myfatoorah | mock
  providerRef    String? // gateway charge/invoice id, used to verify status
  redirectUrl    String? // hosted checkout URL returned by the gateway
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
}

model GiftCode {
  id               String    @id @default(cuid())
  code             String    @unique
  purchaseId       String?   @unique
  packageId        String
  package          Package   @relation(fields: [packageId], references: [id])
  fromUserId       String
  fromUser         User      @relation("GiftSender", fields: [fromUserId], references: [id])
  toPhone          String?
  redeemedByUserId String?
  redeemedByUser   User?     @relation("GiftRedeemer", fields: [redeemedByUserId], references: [id])
  status           String    @default("SENT") // SENT | REDEEMED
  createdAt        DateTime  @default(now())
  redeemedAt       DateTime?
}

// ---------- Firebase-owned wallet and paid admission (INT-5A draft) ----------

model Wallet {
  id                String   @id @default(cuid())
  firebaseIdentityId String  @unique
  available         BigInt   @default(0)
  held              BigInt   @default(0)
  debt              BigInt   @default(0)
  version           BigInt   @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  firebaseIdentity FirebaseIdentity @relation(fields: [firebaseIdentityId], references: [id], onDelete: Restrict)
  entries          WalletEntry[]
  admissions       Admission[]

  @@unique([id, firebaseIdentityId])
}

model WalletEntry {
  id                    String   @id @default(cuid())
  walletId              String
  sequence              BigInt
  originType            String
  originId              String
  effect                String
  reservationId         String?
  deltaAvailable        BigInt
  deltaHeld             BigInt
  deltaDebt             BigInt
  resultingAvailable    BigInt
  resultingHeld         BigInt
  resultingDebt         BigInt
  actorFirebaseIdentityId String?
  evidenceHash          String?
  createdAt             DateTime @default(now())

  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actor         FirebaseIdentity? @relation("WalletEntryActor", fields: [actorFirebaseIdentityId], references: [id], onDelete: Restrict)

  @@unique([walletId, sequence])
  @@unique([walletId, originType, originId, effect])
  @@unique([reservationId, effect])
  @@index([walletId, createdAt])
  // Migration-only partial unique index also limits FREE_FIRST_GRANT by actor Firebase identity.
}

model Admission {
  id                   String   @id @default(cuid())
  firebaseIdentityId   String
  walletId             String
  engine               String
  operation            String
  mode                 String   @default("CLASSIC")
  logicalMatchId       String
  requestKey           String
  requestHash          String
  intentHash           String
  requestVersion       Int
  catalogReleaseId     String?
  releaseRootHash      String?
  validationReceiptId  String?
  selectorVersion      String
  state                String   @default("HELD") // HELD | COMMITTED | RELEASED
  storageAuthority     String   @default("LEGACY_PROTOCOL_V1")
  version              Int      @default(0)
  roomProjectId        String?
  roomId               String?
  huroofBinding        Json?
  huroofConfig         Json?
  huroofCatalogReleaseId String?
  huroofCatalogRootHash String?
  huroofValidationReceiptId String?
  predecessorAdmissionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  firebaseIdentity FirebaseIdentity       @relation(fields: [firebaseIdentityId], references: [id], onDelete: Restrict)
  wallet           Wallet                 @relation(fields: [walletId, firebaseIdentityId], references: [id, firebaseIdentityId], onDelete: Restrict)
  catalogRelease   CatalogRelease?         @relation(fields: [catalogReleaseId, releaseRootHash], references: [id, releaseRootHash], onDelete: Restrict)
  validationReceipt CatalogValidationReceipt? @relation(fields: [validationReceiptId, catalogReleaseId, releaseRootHash], references: [id, catalogReleaseId, releaseRootHash], onDelete: Restrict)
  predecessor      Admission? @relation("HuroofPredecessor", fields: [predecessorAdmissionId], references: [id], onDelete: Restrict)
  successors       Admission[] @relation("HuroofPredecessor")
  huroofProof      HuroofAdmissionProof?
  huroofCatalogRelease CatalogRelease? @relation("HuroofAdmissionCatalog", fields: [huroofCatalogReleaseId, huroofCatalogRootHash], references: [id, releaseRootHash], onDelete: Restrict)
  huroofValidationReceipt CatalogValidationReceipt? @relation("HuroofAdmissionReceipt", fields: [huroofValidationReceiptId, huroofCatalogReleaseId, huroofCatalogRootHash], references: [id, catalogReleaseId, releaseRootHash], onDelete: Restrict)
  reservation      Reservation?
  events            AdmissionEvent[]
  outbox            AdmissionOutbox[]
  game              Game?
  huroofMatch HuroofMatch?
  huroofResults HuroofMatchResult[]

  @@unique([id, firebaseIdentityId])
  @@unique([firebaseIdentityId, engine, logicalMatchId])
  @@unique([firebaseIdentityId, requestKey])
  @@unique([roomProjectId, roomId])
  @@index([walletId, state])
  // INT-062 additive restrictive relation source; old fields/guards unchanged.
}

model HuroofAdmissionProof {
  id            String @id
  admissionId   String @unique
  proofVersion  Int
  terminalState String
  proof         Json
  createdAt     DateTime @default(now())
  admission     Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)
}

model Reservation {
  id          String    @id @default(cuid())
  admissionId String    @unique
  quantity    Int       @default(1)
  state       String    @default("HELD") // HELD | COMMITTED | RELEASED
  heldAt      DateTime  @default(now())
  expiresAt   DateTime?
  committedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  admission Admission    @relation(fields: [admissionId], references: [id], onDelete: Restrict)
  entries   WalletEntry[]
}

model AdmissionEvent {
  id          String   @id @default(cuid())
  admissionId String
  sequence    BigInt
  eventType   String
  evidenceHash String?
  detailCode  String?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  @@unique([admissionId, sequence])
  @@index([admissionId, createdAt])
}

model AdmissionOutbox {
  id                 String   @id @default(cuid())
  admissionId        String
  jobKind            String
  transitionVersion  Int
  state              String   @default("PENDING") // PENDING | LEASED | DONE | FAILED
  availableAt        DateTime @default(now())
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  leaseVersion       Int      @default(0)
  attemptCount       Int      @default(0)
  lastErrorCode      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Restrict)

  @@unique([admissionId, jobKind, transitionVersion])
  @@index([state, availableAt])
}

// ---------- Content: categories & questions ----------

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🎯")
  color     String   @default("#6C4CE0")
  imageUrl  String? // cover photo shown on the category card
  type      String   @default("PERMANENT") // PERMANENT | SEASONAL | KIDS | DRAWING | STUDENT | LIST
  seasonTag String? // e.g. RAMADAN_2026
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  questions      Question[]
  gameCategories GameCategory[]
  favorites      FavoriteCategory[]
}

model Question {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  text       String
  answer     String
  hint       String?
  hint2      String?
  hint3      String?
  hint4      String?
  imageUrl   String? // shown instead of/alongside text, e.g. a flag to identify
  videoUrl   String? // a clip to play instead of/alongside an image, e.g. a goal
  grayscale  Boolean  @default(false) // strip the colors so team kits give nothing away
  points     Int      @default(200) // 100/200/300 tiers
  isDrawing  Boolean  @default(false)
  createdAt  DateTime @default(now())

  gameQuestions GameQuestion[]
  varReports    VarReport[]
  answers       QuestionAnswer[]
}

// One of several hidden answers to a single question, each carrying its own
// score. Used by the list round ("السهل الممتنع"), where a team names as many
// as it can before the clock runs out and the obvious ones are worth least.
model QuestionAnswer {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  text       String
  points     Int      @default(100)
  // A trap is not one of the hidden slots: it looks like a right answer but
  // sits outside the top ten, and saying it deducts `points` instead.
  isTrap     Boolean  @default(false)
  // Picture of this item, for acting rounds where a photo beats a word.
  imageUrl   String?
  sortOrder  Int      @default(0)
}

model VarReport {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  gameId     String?
  note       String
  status     String   @default("OPEN") // OPEN | RESOLVED
  createdAt  DateTime @default(now())
}

// ---------- Core game session ----------

model Game {
  id               String          @id @default(cuid())
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  gameFormat       String          @default("LEGACY") // LEGACY | FIREBASE_PINNED
  executionFormat  String          @default("TIER_BOARD") // immutable v4 discriminator
  firebaseIdentityId String?
  admissionId      String?
  // Historical rows remain null only when their IDs were captured by the migration.
  catalogReleaseId String?
  catalogReleaseRootHash String?
  validationReceiptId String?
  catalogRelease   CatalogRelease? @relation(fields: [catalogReleaseId], references: [id], onDelete: Restrict)
  validationReceipt CatalogValidationReceipt? @relation("GameValidationReceipt", fields: [validationReceiptId, catalogReleaseId, catalogReleaseRootHash], references: [id, catalogReleaseId, releaseRootHash], onDelete: Restrict)
  firebaseIdentity FirebaseIdentity? @relation(fields: [firebaseIdentityId], references: [id], onDelete: Restrict)
  admission        Admission?       @relation(fields: [admissionId, firebaseIdentityId], references: [id, firebaseIdentityId], onDelete: Restrict)
  legacyUnpinnedEligibility LegacyUnpinnedGame?
  mode             String          @default("CLASSIC") // CLASSIC | KIDS | STUDENT | LIST
  status           String          @default("ACTIVE") // ACTIVE | FINISHED
  winnerTeamId     String?
  winnerTeam       Team? @relation("GameWinner", fields: [id, winnerTeamId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction, map: "Game_winner_same_game")
  isTie            Boolean         @default(false)
  createdAt        DateTime        @default(now()) @db.Timestamp(3)
  finishedAt       DateTime?       @db.Timestamp(3)

  teams                  Team[]
  gameCategories         GameCategory[]
  categoryPins           GameCategoryPin[]
  gameQuestions          GameQuestion[]
  runtime                GameRuntime?
  runtimeEvents          GameEvent[]
  rematchLink            EntaRematchLink? @relation("EntaRematchChild")
  paidRematches          EntaRematchLink[] @relation("EntaRematchPredecessor")
  executionPin           EntaExecutionPin?
  formatRounds           GameRound[]
  authorityEvents        RoundAuthorityEvent[]

  @@unique([id, catalogReleaseId])
  @@unique([admissionId, firebaseIdentityId])
  @@unique([id, firebaseIdentityId])
  @@unique([id, admissionId, firebaseIdentityId])
  @@index([firebaseIdentityId, createdAt, id], map: "Game_enta_owner_history_idx")
  // INT-062 additive restrictive relation source; old fields/guards unchanged.
  CompetitiveAuditReport_owner_children CompetitiveAuditReport[] @relation("CompetitiveAuditReport_owner")
  EngineTournamentBindingSnapshot_owner_children EngineTournamentBindingSnapshot[] @relation("EngineTournamentBindingSnapshot_owner")
  EngineMatchResult_owner_children EngineMatchResult[] @relation("EngineMatchResult_owner")
  GameCompetitivePin_admissionSource_children GameCompetitivePin[] @relation("GameCompetitivePin_admissionSource")
  competitiveCapacityClaims CompetitiveCapacityClaim[]
  competitiveCapacityCharges CompetitiveCapacityCharge[]
  competitiveCapacityHeads CompetitiveCapacityHead[]
}

model Team {
  id        String         @id @default(cuid())
  gameId    String
  game      Game           @relation(fields: [gameId], references: [id])
  name      String
  color     String         @default("#6C4CE0")
  score     Int            @default(0)
  players   Player[]
  lifelines TeamLifeline[]

  answeredQuestions GameQuestion[]
  activeRuntimes GameRuntime[]
  runtimeEvents GameEvent[]
  wonGames Game[] @relation("GameWinner")
  scorePostings RoundScorePosting[]
  actorAssignments RoundActorAssignment[]

  @@unique([gameId, id])
  // INT-062 additive restrictive relation source; old fields/guards unchanged.
  CompetitiveRosterPlayer_team_children CompetitiveRosterPlayer[] @relation("CompetitiveRosterPlayer_team")
  CompetitiveAllowance_team_children CompetitiveAllowance[] @relation("CompetitiveAllowance_team")
  CompetitiveScorePosting_team_children CompetitiveScorePosting[] @relation("CompetitiveScorePosting_team")
  CompetitiveScoreRead_team_children CompetitiveScoreRead[] @relation("CompetitiveScoreRead_team")
  CompetitiveItemConsumption_team_children CompetitiveItemConsumption[] @relation("CompetitiveItemConsumption_team")
  EngineTournamentBindingParticipant_participant_children EngineTournamentBindingParticipant[] @relation("EngineTournamentBindingParticipant_participant")
}

model Player {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])
  name   String
  // INT-062 additive restrictive relation source; old fields/guards unchanged.
  @@unique([id, teamId])
  CompetitiveRosterPlayer_player_children CompetitiveRosterPlayer[] @relation("CompetitiveRosterPlayer_player")
}

model TeamLifeline {
  id     String  @id @default(cuid())
  teamId String
  team   Team    @relation(fields: [teamId], references: [id])
  type   String // PHONE_A_FRIEND | DOUBLE_ANSWER | MORE_HINT | TRAP | PICK_ANSWERER | STEAL_POINTS | DOUBLE_POINTS
  used   Boolean @default(false)
}

model GameCategory {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
}

model GameCategoryPin {
  id                  String @id @default(cuid())
  gameId              String
  catalogReleaseId    String
  categoryKey         String
  categoryRevisionId  String
  ordinal             Int

  game Game @relation(fields: [gameId, catalogReleaseId], references: [id, catalogReleaseId], onDelete: Restrict)
  releaseCategory CatalogReleaseCategory @relation(fields: [catalogReleaseId, categoryKey, categoryRevisionId], references: [catalogReleaseId, categoryKey, categoryRevisionId], onDelete: Restrict)

  formatRounds GameRound[]
  @@unique([gameId, ordinal])
  @@unique([gameId, categoryKey])
}

model GameQuestion {
  id                 String                  @id @default(cuid())
  gameId             String
  catalogReleaseId   String?
  game               Game?                   @relation(fields: [gameId, catalogReleaseId], references: [id, catalogReleaseId], onDelete: Restrict)
  questionId         String?
  question           Question?               @relation(fields: [questionId], references: [id], onDelete: Restrict)
  // Null on historical rows; pinned rows must belong to this same catalog release.
  questionRevisionId String?
  catalogMembership  CatalogReleaseQuestion? @relation(fields: [catalogReleaseId, questionRevisionId], references: [catalogReleaseId, questionRevisionId], onDelete: Restrict)
  answeredByTeamId   String?
  answeredByTeam     Team?                   @relation(fields: [gameId, answeredByTeamId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction, map: "GameQuestion_answer_same_game")
  isCorrect          Boolean?
  // With more than two teams the host can rule the answer correct for several
  // of them at once; these are the extra teams that also scored, kept here so
  // undo can take the points back off every one of them.
  alsoCorrectTeamIds String[]                @default([])
  isOpened           Boolean                 @default(false)
  usedVar            Boolean                 @default(false)
  activeRuntimes      GameRuntime[]
  runtimeEvents      GameEvent[]
  formatRound        GameRound?

  @@unique([gameId, questionRevisionId])
  @@unique([gameId, id])
}

// INT-060.E1 additive SOURCE draft. No datasource/schema application implied.
model GameRuntime {
  gameId           String @id
  version          Int @default(1)
  state            String @default("BOARD")
  setup            Json
  setupHash        String
  teamOrder        String[]
  turnIndex        Int @default(0)
  activeQuestionId String?
  activeTeamId     String?
  activeRoundId    String?
  deadlineAt       DateTime? @db.Timestamptz(3)
  resultReason     String?
  unplayedCount    Int @default(0)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  activeQuestion GameQuestion? @relation(fields: [gameId, activeQuestionId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction)
  activeTeam Team? @relation(fields: [gameId, activeTeamId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction)
  activeRound GameRound? @relation("ActiveFormatRound", fields: [gameId, activeRoundId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction)
}

model GameEvent {
  gameId                  String
  commandId               String
  sequence                Int
  actorFirebaseIdentityId String
  type                    String
  intentHash              String
  questionId              String?
  teamId                  String?
  ruling                  String?
  resultReason            String?
  unplayedCount           Int?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  game Game @relation(fields: [gameId, actorFirebaseIdentityId], references: [id, firebaseIdentityId], onDelete: Restrict, onUpdate: NoAction)
  question GameQuestion? @relation(fields: [gameId, questionId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction)
  team Team? @relation(fields: [gameId, teamId], references: [gameId, id], onDelete: Restrict, onUpdate: NoAction)
  rematchLinks EntaRematchLink[]

  @@id([gameId, commandId])
  @@unique([gameId, sequence])
  // INT-062 additive restrictive relation source; old fields/guards unchanged.
  EngineMatchResult_terminal_children EngineMatchResult[] @relation("EngineMatchResult_terminal")
}

// INT-060.E2 source only. Links reference immutable FINISH event versions.
model EntaRematchLink {
  childGameId String @id
  firebaseIdentityId String
  predecessorGameId String
  predecessorRuntimeVersion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  child Game @relation("EntaRematchChild", fields: [childGameId, firebaseIdentityId], references: [id, firebaseIdentityId], onDelete: Restrict, onUpdate: NoAction)
  predecessor Game @relation("EntaRematchPredecessor", fields: [predecessorGameId, firebaseIdentityId], references: [id, firebaseIdentityId], onDelete: Restrict, onUpdate: NoAction)
  finishEvent GameEvent @relation(fields: [predecessorGameId, predecessorRuntimeVersion], references: [gameId, sequence], onDelete: Restrict, onUpdate: NoAction)
  @@unique([childGameId, firebaseIdentityId])
}

// Future reviewed issuer must bind these immutable mode facts. No authoring
// route/grant/seed or permissive activation is added by the E2 source tranche.
model EntaModeReleaseEvidence {
  receiptId String
  mode String
  catalogReleaseId String
  releaseRootHash String
  policyVersion String
  targetCohort String?
  reviewerIdentityId String
  evidenceHash String
  kidsSources Json
  kidsProofs Json
  suitabilityManifestHash String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  receipt CatalogValidationReceipt @relation(fields: [receiptId, catalogReleaseId, releaseRootHash], references: [id, catalogReleaseId, releaseRootHash], onDelete: Restrict, onUpdate: NoAction)
  reviewer FirebaseIdentity @relation(fields: [reviewerIdentityId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@id([receiptId, mode])
}

// ---------- Immutable reviewed catalog (INT-4; no rows are seeded) ----------

model SourceCategoryCrosswalkRevision {
  id                   String   @id @default(cuid())
  sourceNamespace      String
  sourceCategoryId     String
  revision             Int
  canonicalCategoryKey String
  mappingHash          String
  createdAt            DateTime @default(now())

  questionRevisions QuestionRevision[]

  @@unique([sourceNamespace, sourceCategoryId, revision], map: "SourceCrosswalk_source_revision_key")
  @@unique([sourceNamespace, sourceCategoryId, mappingHash], map: "SourceCrosswalk_source_hash_key")
  @@unique([id, sourceNamespace, sourceCategoryId, revision, canonicalCategoryKey])
  @@unique([id, mappingHash])
}

model CanonicalCategoryRevision {
  id                   String   @id @default(cuid())
  sourceNamespace      String   @default("canonical.category")
  categoryKey          String
  revision             Int
  labelAr              String
  description          String?
  coverMediaRevisionId String?
  contentHash          String
  editorialReceiptId   String
  editorialDecision    String   @default("APPROVED")
  createdAt            DateTime @default(now())

  coverMedia        MediaRevision?           @relation("CanonicalCover", fields: [coverMediaRevisionId], references: [id], onDelete: Restrict)
