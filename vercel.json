{
  "framework": "vite",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "buildCommand": "npm run build:production",
  "functions": {
    "api/index.ts": {
      "includeFiles": "services/enta/server/prisma/schema.prisma"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__api_path=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
